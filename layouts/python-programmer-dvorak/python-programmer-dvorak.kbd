;; Python Programmer Dvorak (generated by layout-optimizer/export.py)
;; Run kanata with the OS keyboard layout set to US QWERTY.
;; - Plain and Shift keypresses type the layout; with Ctrl/Alt/Win held, keys stay QWERTY.
;; - Right Shift + WASD = arrows (Left Shift/Ctrl still combine); with other keys Right Shift
;;   acts as Shift.
;; - Caps Lock toggles plain QWERTY; Shift+Caps Lock is Caps Lock.

(defcfg
  process-unmapped-keys yes
)

(defsrc
  grv 1 2 3 4 5 6 7 8 9 0 - =
  q w e r t y u i o p [ ] \
  caps a s d f g h j k l ; '
  lsft z x c v b n m , . / rsft
)

(defalias
  caps (fork (layer-switch qwerty) caps (lsft rsft))
  base (fork (layer-switch base) caps (lsft rsft))
  rnav (layer-while-held rnav)
  k0 (fork (fork S-/ S-1 (lsft rsft)) grv (lctl rctl lalt ralt lmet rmet))  ;; `: ? !
  n0 (fork S-1 S-grv (lctl rctl lalt ralt lmet rmet))
  k1 (fork (fork S-= (unshift 1) (lsft rsft)) 1 (lctl rctl lalt ralt lmet rmet))  ;; 1: + 1
  n1 (fork (unshift 1) S-1 (lctl rctl lalt ralt lmet rmet))
  k2 (fork (fork / (unshift 2) (lsft rsft)) 2 (lctl rctl lalt ralt lmet rmet))  ;; 2: / 2
  n2 (fork (unshift 2) S-2 (lctl rctl lalt ralt lmet rmet))
  k3 (fork (fork S-9 (unshift 3) (lsft rsft)) 3 (lctl rctl lalt ralt lmet rmet))  ;; 3: ( 3
  n3 (fork (unshift 3) S-3 (lctl rctl lalt ralt lmet rmet))
  k4 (fork (fork [ (unshift 4) (lsft rsft)) 4 (lctl rctl lalt ralt lmet rmet))  ;; 4: [ 4
  n4 (fork (unshift 4) S-4 (lctl rctl lalt ralt lmet rmet))
  k5 (fork (fork ] (unshift 5) (lsft rsft)) 5 (lctl rctl lalt ralt lmet rmet))  ;; 5: ] 5
  n5 (fork (unshift 5) S-5 (lctl rctl lalt ralt lmet rmet))
  k6 (fork (fork S-5 (unshift 6) (lsft rsft)) 6 (lctl rctl lalt ralt lmet rmet))  ;; 6: % 6
  n6 (fork (unshift 6) S-6 (lctl rctl lalt ralt lmet rmet))
  k7 (fork (fork S-; (unshift 7) (lsft rsft)) 7 (lctl rctl lalt ralt lmet rmet))  ;; 7: : 7
  n7 (fork (unshift 7) S-7 (lctl rctl lalt ralt lmet rmet))
  k8 (fork (fork S-0 (unshift 8) (lsft rsft)) 8 (lctl rctl lalt ralt lmet rmet))  ;; 8: ) 8
  n8 (fork (unshift 8) S-8 (lctl rctl lalt ralt lmet rmet))
  k9 (fork (fork S-[ (unshift 9) (lsft rsft)) 9 (lctl rctl lalt ralt lmet rmet))  ;; 9: { 9
  n9 (fork (unshift 9) S-9 (lctl rctl lalt ralt lmet rmet))
  k10 (fork (fork S-] (unshift 0) (lsft rsft)) 0 (lctl rctl lalt ralt lmet rmet))  ;; 0: } 0
  n10 (fork (unshift 0) S-0 (lctl rctl lalt ralt lmet rmet))
  k11 (fork (fork S-2 S-7 (lsft rsft)) - (lctl rctl lalt ralt lmet rmet))  ;; -: @ &
  n11 (fork S-7 S-- (lctl rctl lalt ralt lmet rmet))
  k12 (fork (fork S-, S-grv (lsft rsft)) = (lctl rctl lalt ralt lmet rmet))  ;; =: < ~
  n12 (fork S-grv S-= (lctl rctl lalt ralt lmet rmet))
  k13 (fork (fork S-' S-. (lsft rsft)) q (lctl rctl lalt ralt lmet rmet))  ;; q: " >
  n13 (fork S-. S-q (lctl rctl lalt ralt lmet rmet))
  k14 (fork (fork , (unshift ') (lsft rsft)) w (lctl rctl lalt ralt lmet rmet))  ;; w: , '
  n14 (fork (unshift ') S-w (lctl rctl lalt ralt lmet rmet))
  k15 (fork (fork . (unshift -) (lsft rsft)) e (lctl rctl lalt ralt lmet rmet))  ;; e: . -
  n15 (fork (unshift -) S-e (lctl rctl lalt ralt lmet rmet))
  k16 (fork (fork p S-p (lsft rsft)) r (lctl rctl lalt ralt lmet rmet))  ;; r: p P
  n16 (fork S-p S-r (lctl rctl lalt ralt lmet rmet))
  k17 (fork (fork y S-y (lsft rsft)) t (lctl rctl lalt ralt lmet rmet))  ;; t: y Y
  n17 (fork S-y S-t (lctl rctl lalt ralt lmet rmet))
  k18 (fork (fork f S-f (lsft rsft)) y (lctl rctl lalt ralt lmet rmet))  ;; y: f F
  n18 (fork S-f S-y (lctl rctl lalt ralt lmet rmet))
  k19 (fork (fork g S-g (lsft rsft)) u (lctl rctl lalt ralt lmet rmet))  ;; u: g G
  n19 (fork S-g S-u (lctl rctl lalt ralt lmet rmet))
  k20 (fork (fork c S-c (lsft rsft)) i (lctl rctl lalt ralt lmet rmet))  ;; i: c C
  n20 (fork S-c S-i (lctl rctl lalt ralt lmet rmet))
  k21 (fork (fork r S-r (lsft rsft)) o (lctl rctl lalt ralt lmet rmet))  ;; o: r R
  n21 (fork S-r S-o (lctl rctl lalt ralt lmet rmet))
  k22 (fork (fork l S-l (lsft rsft)) p (lctl rctl lalt ralt lmet rmet))  ;; p: l L
  n22 (fork S-l S-p (lctl rctl lalt ralt lmet rmet))
  k23 (fork (fork S-3 (unshift ;) (lsft rsft)) [ (lctl rctl lalt ralt lmet rmet))  ;; [: # ;
  n23 (fork (unshift ;) S-[ (lctl rctl lalt ralt lmet rmet))
  k24 (fork (fork \ S-6 (lsft rsft)) ] (lctl rctl lalt ralt lmet rmet))  ;; ]: \ ^
  n24 (fork S-6 S-] (lctl rctl lalt ralt lmet rmet))
  k25 (fork (fork S-\ S-4 (lsft rsft)) \ (lctl rctl lalt ralt lmet rmet))  ;; \: | $
  n25 (fork S-4 S-\ (lctl rctl lalt ralt lmet rmet))
  k26 (fork (fork a S-a (lsft rsft)) a (lctl rctl lalt ralt lmet rmet))  ;; a: a A
  n26 (fork S-a S-a (lctl rctl lalt ralt lmet rmet))
  k27 (fork (fork o S-o (lsft rsft)) s (lctl rctl lalt ralt lmet rmet))  ;; s: o O
  n27 (fork S-o S-s (lctl rctl lalt ralt lmet rmet))
  k28 (fork (fork e S-e (lsft rsft)) d (lctl rctl lalt ralt lmet rmet))  ;; d: e E
  n28 (fork S-e S-d (lctl rctl lalt ralt lmet rmet))
  k29 (fork (fork u S-u (lsft rsft)) f (lctl rctl lalt ralt lmet rmet))  ;; f: u U
  n29 (fork S-u S-f (lctl rctl lalt ralt lmet rmet))
  k30 (fork (fork i S-i (lsft rsft)) g (lctl rctl lalt ralt lmet rmet))  ;; g: i I
  n30 (fork S-i S-g (lctl rctl lalt ralt lmet rmet))
  k31 (fork (fork d S-d (lsft rsft)) h (lctl rctl lalt ralt lmet rmet))  ;; h: d D
  n31 (fork S-d S-h (lctl rctl lalt ralt lmet rmet))
  k32 (fork (fork h S-h (lsft rsft)) j (lctl rctl lalt ralt lmet rmet))  ;; j: h H
  n32 (fork S-h S-j (lctl rctl lalt ralt lmet rmet))
  k33 (fork (fork t S-t (lsft rsft)) k (lctl rctl lalt ralt lmet rmet))  ;; k: t T
  n33 (fork S-t S-k (lctl rctl lalt ralt lmet rmet))
  k34 (fork (fork n S-n (lsft rsft)) l (lctl rctl lalt ralt lmet rmet))  ;; l: n N
  n34 (fork S-n S-l (lctl rctl lalt ralt lmet rmet))
  k35 (fork (fork s S-s (lsft rsft)) ; (lctl rctl lalt ralt lmet rmet))  ;; ;: s S
  n35 (fork S-s S-; (lctl rctl lalt ralt lmet rmet))
  k36 (fork (fork = S-8 (lsft rsft)) ' (lctl rctl lalt ralt lmet rmet))  ;; ': = *
  n36 (fork S-8 S-' (lctl rctl lalt ralt lmet rmet))
  k37 (fork (fork S-- (unshift grv) (lsft rsft)) z (lctl rctl lalt ralt lmet rmet))  ;; z: _ `
  n37 (fork (unshift grv) S-z (lctl rctl lalt ralt lmet rmet))
  k38 (fork (fork q S-q (lsft rsft)) x (lctl rctl lalt ralt lmet rmet))  ;; x: q Q
  n38 (fork S-q S-x (lctl rctl lalt ralt lmet rmet))
  k39 (fork (fork j S-j (lsft rsft)) c (lctl rctl lalt ralt lmet rmet))  ;; c: j J
  n39 (fork S-j S-c (lctl rctl lalt ralt lmet rmet))
  k40 (fork (fork k S-k (lsft rsft)) v (lctl rctl lalt ralt lmet rmet))  ;; v: k K
  n40 (fork S-k S-v (lctl rctl lalt ralt lmet rmet))
  k41 (fork (fork x S-x (lsft rsft)) b (lctl rctl lalt ralt lmet rmet))  ;; b: x X
  n41 (fork S-x S-b (lctl rctl lalt ralt lmet rmet))
  k42 (fork (fork b S-b (lsft rsft)) n (lctl rctl lalt ralt lmet rmet))  ;; n: b B
  n42 (fork S-b S-n (lctl rctl lalt ralt lmet rmet))
  k43 (fork (fork m S-m (lsft rsft)) m (lctl rctl lalt ralt lmet rmet))  ;; m: m M
  n43 (fork S-m S-m (lctl rctl lalt ralt lmet rmet))
  k44 (fork (fork w S-w (lsft rsft)) , (lctl rctl lalt ralt lmet rmet))  ;; ,: w W
  n44 (fork S-w S-, (lctl rctl lalt ralt lmet rmet))
  k45 (fork (fork v S-v (lsft rsft)) . (lctl rctl lalt ralt lmet rmet))  ;; .: v V
  n45 (fork S-v S-. (lctl rctl lalt ralt lmet rmet))
  k46 (fork (fork z S-z (lsft rsft)) / (lctl rctl lalt ralt lmet rmet))  ;; /: z Z
  n46 (fork S-z S-/ (lctl rctl lalt ralt lmet rmet))
)

(deflayer base
  @k0 @k1 @k2 @k3 @k4 @k5 @k6 @k7 @k8 @k9 @k10 @k11 @k12
  @k13 @k14 @k15 @k16 @k17 @k18 @k19 @k20 @k21 @k22 @k23 @k24 @k25
  @caps @k26 @k27 @k28 @k29 @k30 @k31 @k32 @k33 @k34 @k35 @k36
  lsft @k37 @k38 @k39 @k40 @k41 @k42 @k43 @k44 @k45 @k46 @rnav
)

;; Right Shift held: shifted characters, WASD = arrows
(deflayer rnav
  @n0 @n1 @n2 @n3 @n4 @n5 @n6 @n7 @n8 @n9 @n10 @n11 @n12
  @n13 up @n15 @n16 @n17 @n18 @n19 @n20 @n21 @n22 @n23 @n24 @n25
  caps left down rght @n29 @n30 @n31 @n32 @n33 @n34 @n35 @n36
  lsft @n37 @n38 @n39 @n40 @n41 @n42 @n43 @n44 @n45 @n46 _
)

(deflayer qwerty
  grv 1 2 3 4 5 6 7 8 9 0 - =
  q w e r t y u i o p [ ] \
  @base a s d f g h j k l ; '
  lsft z x c v b n m , . / rsft
)
